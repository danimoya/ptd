# Password for the bundled ptd-db (SCRAM-SHA-256). Any long random string.
DB_PASSWORD=change-me
# JWT signing secret: `openssl rand -base64 48`
JWT_SECRET=change-me
# AES-256-GCM key for integration secrets at rest: `openssl rand -hex 32`
PTD_SECRET_KEY=change-me
# Database encryption at rest (AES-256-GCM), 64 hex chars: `openssl rand -hex 32`.
# Decide before first start: it cannot be enabled later on an existing data volume. Keep a copy —
# without it the data is unreadable.
DB_ENCRYPTION_KEY=
# Set to 1 only on the hosted deployment; self-hosters leave it empty (no billing UI).
PTD_HOSTED=
# HeliosDB-Nano release to build ptd-db from (see https://github.com/Dimensigon/HDB-HeliosDB-Nano/releases)
NANO_VERSION=4.40.0

# ── Slack app (optional) ──────────────────────────────────────────────────────
# Without these three the Org → Integrations tab says "Slack app not configured on
# this server" instead of offering an install button. Create one app per PTD
# deployment at https://api.slack.com/apps, with the bot scopes commands, chat:write,
# users:read and users:read.email, the slash command /ptd pointed at
# <PTD_BASE_URL>/api/integrations/slack/commands and the redirect URL below;
# each organization then installs it into its own workspace with "Add to Slack",
# and its bot token is sealed with PTD_SECRET_KEY in org_integrations.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Public origin of this deployment, used to build the OAuth redirect URI and to
# make the slash-command URL you register with Slack. Required behind a proxy.
PTD_BASE_URL=
# Only if the redirect URI registered with Slack is not
# <PTD_BASE_URL>/api/integrations/slack/callback
SLACK_REDIRECT_URI=

# ── Outgoing mail (optional) ──────────────────────────────────────────────────
# Without SMTP_HOST nothing is mailed: invitations still work (the API returns
# `acceptUrl`, the Org tab shows the link) and a password reset link is written to
# the server log instead. One line at startup says which of the two you are in.
SMTP_HOST=
# Defaults to 465 when SMTP_SECURE is set, else 587.
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Envelope From. Must be an address the relay will accept.
SMTP_FROM=PTD <no-reply@example.com>
# 1 = implicit TLS (port 465). Empty = plain connect, then STARTTLS (587).
SMTP_SECURE=
# 1 = do not verify the server certificate. Needed for a Mailcow submission port
# presenting a self-signed or mismatched certificate; it does disable verification,
# so leave it empty unless that is your situation.
SMTP_ACCEPT_INVALID_CERTS=

# ── GitHub Issues sync (optional) ─────────────────────────────────────────────
# One GitHub App per deployment; each organization installs it and maps a stream
# to a repository. Create it at https://github.com/settings/apps/new with:
#   permissions:      Issues read & write, Metadata read
#   webhook events:   Issues, Issue comment
#   webhook URL:      <PTD_BASE_URL>/api/integrations/github/webhook
#   setup URL:        <PTD_BASE_URL>/api/integrations/github/setup   ("redirect on update" on)
# Unset, the Org → Integrations card says "GitHub app not configured on this server".
GITHUB_APP_ID=
# The App's URL slug — github.com/apps/<slug> — used to build the install link.
GITHUB_APP_SLUG=
# The webhook secret you typed into the App's settings. Every delivery is verified
# against it (X-Hub-Signature-256) and refused without it.
GITHUB_WEBHOOK_SECRET=
# The App's private key .pem, base64-encoded so it fits on one line:
#   base64 -w0 your-app.private-key.pem
# A raw PEM (with real newlines or \n escapes) is accepted too.
GITHUB_APP_PRIVATE_KEY=
# Only if the setup URL registered with GitHub is not
# <PTD_BASE_URL>/api/integrations/github/setup
GITHUB_SETUP_URL=

# ── Telegram bot (optional) ───────────────────────────────────────────────────
# One bot per deployment: talk to @BotFather, send /newbot, paste the token here.
# An admin then runs telegram.register_webhook from Org → Integrations, which calls
# setWebhook pointing at <PTD_BASE_URL>/api/integrations/telegram/webhook/<secret>.
# The <secret> is derived from HMAC(PTD_SECRET_KEY, token) — nothing to configure,
# and rotating either input rotates the URL. PTD_BASE_URL must be https.
TELEGRAM_BOT_TOKEN=

# ── Microsoft Teams (optional) ────────────────────────────────────────────────
# Nothing goes here. Teams is an Outgoing Webhook created inside Teams (Manage team
# → Apps → Create an outgoing webhook) pointing at
# <PTD_BASE_URL>/api/integrations/teams/webhook; an admin pastes the secret Teams
# shows once into Org → Integrations → Microsoft Teams, and it is sealed with
# PTD_SECRET_KEY like every other third-party credential.

# AI-assisted priority (off unless both are set). Provider: anthropic | openai.
PTD_AI_PROVIDER=
PTD_AI_API_KEY=
# Optional: model override (defaults claude-haiku-4-5 / gpt-4o-mini), base URL, timeout (ms)
PTD_AI_MODEL=
PTD_AI_BASE_URL=
PTD_AI_TIMEOUT_MS=30000
